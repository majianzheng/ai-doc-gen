# ---- Transport ----
# stdio  : for generic AI agents that launch the process directly (Claude Desktop, etc.)
# http   : for remote agents (Dify MCP, OpenAI, etc.) + REST API + static file serving
DOC_MCP_TRANSPORT=http

# ---- Logging ----
# Enable verbose logging
VERBOSE=false

# ---- HTTP server ----
HOST=0.0.0.0
PORT=9000
# MCP endpoints are served under this path
MCP_PATH=/mcp

# ---- Admin web UI (independent management console, runs on its own port) ----
# Enabled by default in http mode. Features: generated-file management
# (list / preview / download / delete), document template customization and
# document generation. The port is deliberately separated from the service
# port (PORT) so the management UI never interferes with MCP / REST traffic.
ADMIN_ENABLED=true
ADMIN_HOST=0.0.0.0
ADMIN_PORT=9800
# Directory (JSON files) where document templates are persisted by the admin UI
TEMPLATE_DIR=templates
# Directory where uploaded file-based style templates (pptx/docx/xlsx) are stored
STYLE_TEMPLATE_DIR=style-templates
# Directory where admin data (users, SSO config, session secret) is persisted
DATA_DIR=admin-data

# ---- Admin accounts & SSO ----
# Built-in super administrator (created on first start). WARNING: keep the
# initial password known only to the operator; change it after first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Usernames that get the `admin` role automatically when they first sign in via
# SSO (comma separated). Every other SSO user is created with the `user` role.
ADMIN_SSO_ADMINS=
# Optional: fixed secret used to sign admin session cookies (JWT HS256).
# When blank, a random secret is generated once and persisted under DATA_DIR.
#ADMIN_SESSION_SECRET=

# ---- Storage mode: 'local' (development) or 's3' (S3 / MinIO / OSS / COS) ----
STORAGE_MODE=local

# ---- Local storage (used when STORAGE_MODE=local) ----
# Base URL that agents / users can reach the generated files through.
# When running remotely, set this to your server's public URL, e.g. https://docs.example.com
LOCAL_STORAGE_DIR=storage
LOCAL_PUBLIC_BASE_URL=http://localhost:9000

# ---- S3-compatible storage (used when STORAGE_MODE=s3) ----
# Works with AWS S3, MinIO, Aliyun OSS, Tencent COS.
#S3_ENDPOINT=http://localhost:9000          # blank for AWS S3
#S3_REGION=us-east-1
#S3_ACCESS_KEY=minioadmin
#S3_SECRET_KEY=minioadmin
#S3_BUCKET=ai-doc
#S3_PATH_STYLE=true                          # MinIO/OSS usually true; AWS uses virtual-hosted style (false)
# Public base URL prefix for generated download links, e.g. https://cdn.example.com
# (optional; if blank, derived from the S3 endpoint + bucket)
#S3_PUBLIC_BASE_URL=
